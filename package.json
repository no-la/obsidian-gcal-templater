{
  "name": "obsidian-gcal-templater",
  "version": "0.1.2",
  "description": "Expose Google Calendar event queries to Obsidian Templater.",
  "main": "main.js",
  "scripts": {
    "dev": "tsc -noEmit -skipLibCheck --watch",
    "build": "tsc -noEmit -skipLibCheck && node build.mjs",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "google-calendar",
    "templater"
  ],
  "author": "no-la",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
